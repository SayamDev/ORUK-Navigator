# Server-only PostgreSQL connection. Never rename this to NEXT_PUBLIC_DATABASE_URL.
# This value is for the local Supabase stack only; use a secret-managed URL in deployment.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Vercel + Supabase transaction-pooler deployments set these to 1 and false.
DATABASE_POOL_SIZE=10
DATABASE_PREPARE=true

# Optional override used only by the repository integration test runner.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Server-only secrets. Generate independent random values of at least 32 characters.
# The maintenance value must also be stored as the matching GitHub Actions secret.
CORRECTION_RATE_LIMIT_SECRET=replace-with-a-random-server-only-secret
OPERATIONS_MAINTENANCE_SECRET=replace-with-a-different-random-secret

# Public correction intake fails closed until operational coverage is named.
PUBLIC_CORRECTIONS_ENABLED=false
CORRECTIONS_FALLBACK_OWNER=
CORRECTIONS_REVIEW_HOURS=
