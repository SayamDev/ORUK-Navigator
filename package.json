{
  "name": "oruk-navigator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:audit": "pnpm audit --prod --audit-level high",
    "search:rebuild": "node scripts/rebuild-search-projection.mjs",
    "recovery:rehearse": "node scripts/rehearse-recovery.mjs",
    "db:start": "supabase db start",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "db:lint": "supabase db lint --local --level error",
    "test:repositories": "supabase db reset --local && vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "cheerio": "1.2.0",
    "next": "16.3.5",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.0.1",
    "supabase": "2.117.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.1"
  }
}
